{
  "comment": "SMOKE TEST for the Step 9 arms: 8 arms x 3 seeds x 20 epochs. LReLUM arms use a PLACEHOLDER slope of 0.1 (not the calibrated value). Pipeline check only; never research results.",
  "name": "smoke-main-arms",
  "mode": "smoke",
  "seeds": {
    "start": 0,
    "count": 3
  },
  "train": {
    "epochs": 20,
    "batch_size": 128,
    "lr": 0.001,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08,
    "weight_decay": 0.0,
    "n_layers": 10,
    "width": 2,
    "log_every": 10,
    "checkpoint_every": 5
  },
  "arms": [
    {
      "name": "ReLU-He",
      "activation": "relu",
      "init": "he"
    },
    {
      "name": "LReLU001-He",
      "activation": "leaky_relu",
      "init": "he",
      "act_kwargs": {
        "negative_slope": 0.01
      }
    },
    {
      "name": "DARL-He",
      "activation": "darl",
      "init": "he"
    },
    {
      "name": "LReLUM-He",
      "activation": "leaky_relu",
      "init": "he",
      "act_kwargs": {
        "negative_slope": 0.1
      }
    },
    {
      "name": "ReLU-RAI",
      "activation": "relu",
      "init": "rai"
    },
    {
      "name": "LReLU001-RAI",
      "activation": "leaky_relu",
      "init": "rai",
      "act_kwargs": {
        "negative_slope": 0.01
      }
    },
    {
      "name": "DARL-RAI",
      "activation": "darl",
      "init": "rai"
    },
    {
      "name": "LReLUM-RAI",
      "activation": "leaky_relu",
      "init": "rai",
      "act_kwargs": {
        "negative_slope": 0.1
      }
    }
  ],
  "data_config": "configs/a1/data.json",
  "thresholds": "configs/a1/outcomes.json",
  "results_root": "results/a1"
}
